;;; agent-default-test.el --- Machine-local agent preference -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'agent-workflow)

(ert-deftest rsr/agent-default-selector-validates-and-inverts ()
  (dolist (default '(claude pi))
    (let ((rsr/agent-sessions-default-agent default))
      (should (equal (rsr/agent-sessions-select-agent) (symbol-name default)))
      (dolist (prefix '(t (4) (16) -1))
        (should (equal (rsr/agent-sessions-select-agent prefix)
                       (if (eq default 'pi) "claude" "pi"))))))
  (let ((rsr/agent-sessions-default-agent 'invalid))
    (should-error (rsr/agent-sessions-select-agent) :type 'user-error)))

(ert-deftest rsr/agent-default-tmux-launch-and-explicit-wrappers ()
  (dolist (default '(claude pi))
    (let ((rsr/agent-sessions-default-agent default) sent)
      (cl-letf (((symbol-function 'rsr/agent-tmux-agent)
                 (lambda (agent) (setq sent agent))))
        (dolist (prefix '(nil (4)))
          (let ((current-prefix-arg prefix))
            (call-interactively #'rsr/agent-tmux-default))
          (should (equal sent (rsr/agent-sessions-select-agent prefix))))
        (rsr/agent-tmux-claude)
        (should (equal sent "claude"))
        (rsr/agent-tmux-pi)
        (should (equal sent "pi"))))))

(ert-deftest rsr/agent-default-all-workflow-keys-use-preference ()
  (dolist (default '(claude pi))
    (let ((rsr/agent-sessions-default-agent default) sent)
      (cl-letf (((symbol-function 'rsr/agent-workflow-open-top-level)
                 (lambda (skill agent) (setq sent (list skill agent))))
                ((symbol-function 'rsr/agent-workflow-open-child)
                 (lambda (skill agent) (setq sent (list skill agent)))))
        (dolist (map (list rsr/agent-workflow-map rsr/agent-workflow-child-map))
          (dolist (entry rsr/agent-workflow-keys)
            (dolist (prefix '(nil (4)))
              (let ((current-prefix-arg prefix))
                (call-interactively (lookup-key map (kbd (car entry)))))
              (should (equal sent (list (nth 1 entry)
                                        (rsr/agent-sessions-select-agent prefix)))))))))))

(ert-deftest rsr/agent-default-terminal-environment-overrides-stale-preference ()
  (dolist (default '(claude pi))
    (let* ((rsr/agent-sessions-default-agent default)
           (process-environment (cons "AGENT_DEFAULT=stale" process-environment))
           (process-environment
            (append (rsr/agent-sessions--terminal-environment "test-id")
                    process-environment)))
      (should (equal (getenv "AGENT_DEFAULT") (symbol-name default)))
      (should (equal (getenv "EMACS_AGENT_SESSION_ID") "test-id")))))

(ert-deftest rsr/agent-default-workflow-process-environment ()
  (let ((rsr/agent-sessions-default-agent 'pi)
        (process-environment (cons "AGENT_DEFAULT=claude" process-environment))
        buffer)
    (unwind-protect
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (setq buffer (plist-get args :buffer))
                     (should (equal (getenv "AGENT_DEFAULT") "pi"))
                     (should (member "--agent" (plist-get args :command)))
                     'fake-process)))
          (rsr/agent-workflow--launch :skill "review-plan" :agent "claude"
                                     :task "/tmp/task/"))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(provide 'agent-default-test)
