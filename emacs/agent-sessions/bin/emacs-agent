#!/bin/sh
# Talk to other agents through the Emacs agent-sessions dashboard.
#
#   emacs-agent spawn --type claude|codex --worktree DIR --task TEXT [--title T] [--model M]
#   emacs-agent send --to ADDRESS --type TYPE --subject S [--body B] [--files csv] [--report P]
#   emacs-agent send-and-wait --to ADDRESS --subject S [--body B] [--type TYPE] [--types csv]
#   emacs-agent done --summary S [--files csv] [--report P] [--subject S] [--to ADDRESS]
#   emacs-agent ask --question Q [--timeout SECONDS] [--to ADDRESS]
#   emacs-agent check [--types csv] [--peek]
#   emacs-agent wait [--types csv] [--timeout SECONDS] [--interval SECONDS]
#   emacs-agent list
#   emacs-agent worktrees
#   emacs-agent guide [--main]
#
# Every verb but `guide' is an emacsclient call into the Emacs that owns this
# terminal, and is gated on EMACS_AGENT_SESSION_ID — the id agent-sessions.el
# injects into every session terminal's environment (along with this script's
# directory on PATH).  Outside such a terminal there is nothing to talk to, so
# these fail loudly rather than pretending to have worked.
#
# Waiting polls from here rather than blocking inside Emacs: an emacsclient
# call runs on Emacs's only thread, so a blocking wait would freeze the editor
# for its whole duration.

set -u

selfdir=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || selfdir=""

usage() {
  sed -n '3,18p' "$0" | sed -e 's/^# \{0,1\}//'
}

die() { echo "emacs-agent: $1" >&2; exit 1; }

need_session() {
  [ -n "${EMACS_AGENT_SESSION_ID:-}" ] ||
    die "not inside an Emacs agent session terminal (no EMACS_AGENT_SESSION_ID)"
  command -v emacsclient >/dev/null 2>&1 || die "emacsclient not found"
}

# Escape a value for interpolation into an elisp string literal.
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Turn emacsclient's printed elisp string back into plain text.
unquote() {
  printf '%s' "$1" | sed -e 's/^"//' -e 's/"$//' \
    -e 's/\\n/\
/g' -e 's/\\t/	/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
}

# call ELISP -> prints the returned string; non-zero only when Emacs is unreachable.
call() {
  reply=$(emacsclient -e "$1" 2>&1) ||
    die "could not reach Emacs: $reply"
  unquote "$reply"
}

# An entry point's failures come back as text, so recognise the shapes that
# mean "did not happen" and exit non-zero on them.
report() { # report OUTPUT SUCCESS-PATTERN
  case "$1" in
    $2) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$1" >&2; exit 1 ;;
  esac
}

verb=${1:-}
[ -n "$verb" ] || { usage >&2; exit 2; }
shift 2>/dev/null || true
case "$verb" in -h|--help|help) usage; exit 0 ;; esac

type_=""; to=""; subject=""; body=""; files=""; report_path=""
worktree=""; task=""; title=""; summary=""; question=""; types=""; model=""
timeout=90; interval=3; peek=""; main=""

while [ $# -gt 0 ]; do
  case "$1" in
    --type) type_=${2:-}; shift 2 ;;
    --to) to=${2:-}; shift 2 ;;
    --subject) subject=${2:-}; shift 2 ;;
    --body) body=${2:-}; shift 2 ;;
    --files) files=${2:-}; shift 2 ;;
    --report) report_path=${2:-}; shift 2 ;;
    --worktree) worktree=${2:-}; shift 2 ;;
    --task) task=${2:-}; shift 2 ;;
    --task-file) task=$(cat -- "${2:-}") || die "cannot read --task-file ${2:-}"; shift 2 ;;
    --title) title=${2:-}; shift 2 ;;
    --model) model=${2:-}; shift 2 ;;
    --summary) summary=${2:-}; shift 2 ;;
    --question) question=${2:-}; shift 2 ;;
    --types) types=${2:-}; shift 2 ;;
    --timeout) timeout=${2:-}; shift 2 ;;
    --interval) interval=${2:-}; shift 2 ;;
    --peek) peek=1; shift ;;
    --main) main=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1 (try 'emacs-agent help')" ;;
  esac
done

do_send() { # do_send TO TYPE SUBJECT BODY FILES REPORT
  out=$(call "(rsr/agent-orchestration-send \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$1")\" \"$(esc "$2")\" \"$(esc "$3")\" \"$(esc "$4")\" \"$(esc "$5")\" \"$(esc "$6")\")")
  report "$out" 'Sent*'
}

do_check() { # do_check TYPES CONSUME -> prints "messages: N" and the messages
  consume=t; [ -n "$2" ] || consume=nil
  call "(rsr/agent-orchestration-check \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$1")\" $consume)"
}

do_wait_check() { # do_wait_check STOP-TYPES -> state line, then all messages
  call "(rsr/agent-orchestration-wait-check \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$1")\")"
}

count_of() { printf '%s' "$1" | sed -n '1s/^messages: \([0-9]*\)$/\1/p'; }
wait_state_of() { printf '%s' "$1" | sed -n '1s/^wait: //p'; }
wait_messages_of() { printf '%s\n' "$1" | sed '1d'; }

# Consume every message, but stop only when one matches TYPES.
poll() { # poll STOP-TYPES TIMEOUT INTERVAL
  started=$(date +%s)
  while :; do
    out=$(do_wait_check "$1")
    state=$(wait_state_of "$out")
    messages=$(wait_messages_of "$out")
    case "$state" in
      error) printf '%s\n' "$messages" >&2; return 1 ;;
      continue|stop) : ;;
      *) die "invalid wait response from Emacs: $out" ;;
    esac
    n=$(count_of "$messages")
    case "$n" in ''|0) : ;; *) printf '%s\n' "$messages" ;; esac
    [ "$state" != stop ] || return 0
    now=$(date +%s)
    elapsed=$((now - started))
    [ "$elapsed" -lt "$2" ] || {
      echo "messages: 0 (no matching message after ${elapsed}s; call wait again to keep waiting)"
      return 0
    }
    sleep "$3"
  done
}

do_send_and_wait() { # TO TYPE SUBJECT BODY FILES REPORT STOP-TYPES TIMEOUT INTERVAL
  do_send "$1" "$2" "$3" "$4" "$5" "$6" || return 1
  poll "$7" "$8" "$9"
}

case "$verb" in
  guide)
    file=guide-worker.md
    [ -z "$main" ] || file=guide-main.md
    path="$selfdir/../../../skills/orca/$file"
    [ -r "$path" ] || die "guide not found at $path"
    cat -- "$path"
    ;;

  spawn)
    need_session
    [ -n "$type_" ] || die "spawn needs --type (claude, codex, ...)"
    [ -n "$worktree" ] || die "spawn needs --worktree DIR (see 'emacs-agent worktrees')"
    [ -n "$task" ] || die "spawn needs --task TEXT or --task-file FILE"
    out=$(call "(rsr/agent-orchestration-spawn \"$(esc "$EMACS_AGENT_SESSION_ID")\" \"$(esc "$type_")\" \"$(esc "$worktree")\" \"$(esc "$task")\" \"$(esc "$title")\" \"$(esc "$model")\")")
    report "$out" 'Spawned*'
    ;;

  send)
    need_session
    [ -n "$to" ] || die "send needs --to ID"
    [ -n "$subject" ] || die "send needs --subject"
    do_send "$to" "$type_" "$subject" "$body" "$files" "$report_path"
    ;;

  send-and-wait)
    need_session
    [ -n "$to" ] || die "send-and-wait needs --to ADDRESS"
    [ -n "$subject" ] || die "send-and-wait needs --subject"
    [ -n "$type_" ] || type_=question
    [ -n "$types" ] || types=answer
    do_send_and_wait "$to" "$type_" "$subject" "$body" "$files" \
      "$report_path" "$types" "$timeout" "$interval"
    ;;

  done)
    need_session
    [ -n "$summary" ] || die "done needs --summary (three sentences)"
    [ -n "$to" ] || to=${EMACS_AGENT_COORDINATOR:-}
    [ -n "$to" ] || die "no coordinator to report to; pass --to ADDRESS"
    [ -n "$subject" ] || subject="Done"
    do_send "$to" done "$subject" "$summary" "$files" "$report_path"
    ;;

  ask)
    need_session
    [ -n "$question" ] || die "ask needs --question"
    [ -n "$to" ] || to=${EMACS_AGENT_COORDINATOR:-}
    [ -n "$to" ] || die "no coordinator to ask; pass --to ADDRESS"
    do_send_and_wait "$to" question "${subject:-Question}" "$question" "" "" \
      answer "$timeout" "$interval"
    ;;

  check)
    need_session
    if [ -n "$peek" ]; then do_check "$types" ""; else do_check "$types" consume; fi
    ;;

  wait)
    need_session
    poll "$types" "$timeout" "$interval"
    ;;

  list)
    need_session
    call "(rsr/agent-orchestration-list \"$(esc "$EMACS_AGENT_SESSION_ID")\")"
    ;;

  worktrees)
    need_session
    out=$(call "(rsr/agent-orchestration-worktrees \"$(esc "$EMACS_AGENT_SESSION_ID")\")")
    report "$out" 'repo:*'
    ;;

  *)
    die "unknown verb: $verb (try 'emacs-agent help')"
    ;;
esac
