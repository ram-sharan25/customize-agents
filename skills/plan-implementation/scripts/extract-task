#!/bin/sh
# Print one task from a workflow plan.org, so an implementer reads only it.
#
#   extract-task PLAN N
#
# Prints the `*** <STATE> Task N — …' heading and everything under it, up to
# the next heading of level three or higher.  Exits 1 when the plan or the
# task is missing.

set -eu

[ $# -eq 2 ] || { sed -n '4p' "$0" | sed 's/^# *//' >&2; exit 2; }
plan=$1; n=$2
[ -r "$plan" ] || { echo "extract-task: no such plan: $plan" >&2; exit 1; }

awk -v n="$n" '
  /^\*{1,3} / {
    if (on) exit
    if ($0 ~ "^\\*\\*\\* ([A-Z]+ )?Task " n "( |$)") { on = 1; found = 1 }
  }
  on { print }
  END { exit found ? 0 : 1 }
' "$plan" || { echo "extract-task: no Task $n in $plan" >&2; exit 1; }
