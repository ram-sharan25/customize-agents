import fs from "node:fs/promises";
import path from "node:path";
import type { ExtensionAPI, ExtensionCommandContext, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { StringEnum } from "@earendil-works/pi-ai";
import { Type } from "typebox";
import { Text } from "@earendil-works/pi-tui";
import { ACTIONS, STAGES, isWritableStage, type Result, type RunSnapshot, type Stage } from "./domain.ts";
import { errorResult, json, validateInput, validateResult, type PublicInput } from "./contracts.ts";
import { createService, type Runtime } from "./service.ts";
import { applyPolicy, assistantHasMixedStart, authorizeRead, restorePolicy, toolAllowed } from "./policy.ts";
import { persistRun, restoreRun } from "./state/session.ts";
import { STAGE_PROMPTS } from "./stages/index.ts";
import { hashFile } from "./org.ts";
import { handoffFromReport, saveHandoff } from "./state/handoffs.ts";

const runtime: Runtime = {};
const SUMMARY_PROMPT = `Return a bounded structured workflow review handoff only: scope, verdict, every finding with severity/location/impact/requested change, ordered resolution queue, constraints/preferences, source stage, and target artifact. Do not copy the detailed branch conversation.`;
function updateUi(ctx: ExtensionContext) { const run = runtime.run; if (!ctx.hasUI) return; if (!run?.active) { ctx.ui.setStatus("requirements-plan", undefined); ctx.ui.setWidget("requirements-plan", undefined); return; } const label = `${run.stage}: ${run.task.id}${run.review_mode ? ` (${run.review_mode})` : ""}`; ctx.ui.setStatus("requirements-plan", ctx.ui.theme.fg(isWritableStage(run.stage) ? "accent" : "warning", label)); ctx.ui.setWidget("requirements-plan", [ctx.ui.theme.fg("muted", `Workflow active — ${label}`)]); }
function emit(ctx: ExtensionContext, result: Result) { if (ctx.mode === "tui" || ctx.mode === "rpc") { if (result.state === "error") ctx.ui.notify(`${result.error.code}: ${result.error.message}`, "error"); else ctx.ui.notify(result.state === "pending_human_decision" ? result.decision.prompt : result.outcome.kind, "info"); } else console.log(json(result)); }
function toolResult(result: Result) { const safe = validateResult(result) ? result : errorResult("status", result.session_id || "unknown", "INVALID_INTERNAL_RESULT", "The extension produced an invalid contract result.", false); return { content: [{ type: "text" as const, text: safe.state === "error" ? `${safe.error.code}: ${safe.error.message}` : safe.state === "pending_human_decision" ? safe.decision.prompt : `${safe.outcome.kind}${"summary" in safe.outcome && safe.outcome.summary ? `: ${safe.outcome.summary}` : ""}` }], details: safe, terminate: safe.state === "pending_human_decision" }; }
function parseCommand(args: string): PublicInput | undefined { const parts = args.trim().match(/(?:[^\s"']+|"[^"]*"|'[^']*')+/g)?.map(x => x.replace(/^['"]|['"]$/g, "")) ?? []; if (!parts.length) return; const action = ACTIONS.includes(parts[0] as any) ? parts.shift() as any : "start"; if (action === "start") { const stage = parts.shift() as Stage; return { action, stage, reference: parts.join(" ") || undefined }; } if (action === "respond") return { action, decision_id: parts.shift(), answer: parts.join(" ") }; return { action }; }
export default function requirementsPlanExtension(pi: ExtensionAPI) {
 const service = createService(pi, runtime);
 let queuedReviewReturn: RunSnapshot | undefined;
 async function transitionIsolated(ctx: ExtensionCommandContext) { const run = runtime.run; if (!run?.active || run.review_mode !== "isolated" || run.origin_id) return; let origin = ctx.sessionManager.getLeafId() ?? undefined; if (!origin) { pi.appendEntry("requirements-plan-anchor", { at: new Date().toISOString() }); origin = ctx.sessionManager.getLeafId() ?? undefined; } if (!origin) throw new Error("Could not establish isolated review origin."); run.origin_id = origin; persistRun(pi, run); const first = ctx.sessionManager.getEntries().find((e: any) => e.type === "message" && e.message?.role === "user"); if (first && first.id !== origin) { const nav = await ctx.navigateTree(first.id, { summarize: false, label: `workflow-${run.stage}` }); if (nav.cancelled) throw new Error("Isolated review navigation was cancelled."); ctx.ui.setEditorText(""); } persistRun(pi, run); updateUi(ctx); pi.sendUserMessage(`Begin the bounded ${run.stage} for ${run.artifacts.map(a => a.path).join(" and ")}.`, { deliverAs: "followUp" }); }
 async function finishReview(ctx: ExtensionCommandContext, prior: RunSnapshot, action: string) { if (!prior.origin_id) throw new Error("Isolated review origin is missing."); const nav = await ctx.navigateTree(prior.origin_id, action === "return-only" ? { summarize: false } : { summarize: true, customInstructions: SUMMARY_PROMPT, replaceInstructions: true, label: `workflow-${prior.stage}-handoff` }); if (nav.cancelled) throw new Error("Review return navigation was cancelled."); if (action === "return-resolve") { const stage: Stage = prior.stage === "review-plan" ? "plan-implementation" : "clarify-requirements"; let next = await service.dispatch({ action: "start", stage, reference: prior.task.directory }, ctx); if (next.state === "pending_human_decision") next = await service.dispatch({ action: "respond", decision_id: next.decision.id, answer: "approve" }, ctx); if (next.state === "active" && runtime.run && prior.handoff_id) { runtime.run.handoff_id = prior.handoff_id; persistRun(pi, runtime.run); } emit(ctx, next); await maybeStartAgent(ctx, next, false); } }
 async function maybeStartAgent(ctx: ExtensionContext, result: Result, fromTool: boolean) { updateUi(ctx); if (result.state !== "active" || !runtime.run) return; if (runtime.run.review_mode === "isolated" && !runtime.run.origin_id) { if (fromTool) { pi.sendUserMessage("/requirements-plan-transition", { deliverAs: "followUp", expandPromptTemplates: true }); return; } } if (runtime.run.review_mode !== "isolated") pi.sendUserMessage(`Continue the native ${runtime.run.stage} for the confirmed artifacts.`, { deliverAs: "followUp" }); }
 async function interactiveDecision(result: Result, ctx: ExtensionCommandContext): Promise<Result> { let current = result; while (current.state === "pending_human_decision" && ctx.hasUI) { const d = current.decision; let answer: string | undefined; if (d.choices?.length) { const picked = await ctx.ui.select(d.prompt, [...d.choices.map(c => `${c.label}${c.description ? ` — ${c.description}` : ""}`), "Other answer…"]); if (picked === undefined) break; const idx = d.choices.findIndex(c => picked.startsWith(c.label)); answer = idx >= 0 ? d.choices[idx].id : await ctx.ui.input(d.prompt, "Your answer"); } else answer = await ctx.ui.input(d.prompt, "Your answer"); if (answer === undefined) break; current = await service.dispatch({ action: "respond", decision_id: d.id, answer }, ctx); } return current; }
 pi.registerCommand("requirements-plan", { description: "Run requirements clarification/review or implementation planning/review", handler: async (args, ctx) => { let input = parseCommand(args ?? ""); if (!input) { if (!ctx.hasUI) { emit(ctx, errorResult("start", ctx.sessionManager.getSessionId(), "STAGE_REQUIRED", "Specify one of the four stages.", true)); return; } const selected = await ctx.ui.select("Requirements and planning stage", [...STAGES]); if (!selected) return; const reference = await ctx.ui.input("Planning task", "Task, directory, or document path"); if (!reference) return; input = { action: "start", stage: selected as Stage, reference }; } const prior = runtime.run ? { ...runtime.run } : undefined; const checked = validateInput(input); let result = checked.ok ? await service.dispatch(checked.value, ctx) : errorResult((input.action ?? "status") as any, ctx.sessionManager.getSessionId(), "INVALID_INPUT", checked.message, true); result = await interactiveDecision(result, ctx); emit(ctx, result); const endAction = result.state === "ok" && result.outcome.kind === "decision_applied" && ["return-only", "return-summary", "return-resolve"].includes(result.outcome.summary ?? "") ? result.outcome.summary : undefined; if (endAction && prior) await finishReview(ctx, prior, endAction); else if (result.state === "active" && runtime.run?.review_mode === "isolated") await transitionIsolated(ctx); else await maybeStartAgent(ctx, result, false); } });
 pi.registerCommand("requirements-plan-return", { description: "Internal queued isolated-review return", handler: async (_args, ctx) => { const prior = queuedReviewReturn; queuedReviewReturn = undefined; if (!prior) { ctx.ui.notify("No queued review return.", "error"); return; } const action = prior.last_error?.message ?? "return-only"; try { await finishReview(ctx, prior, action); } catch (e: any) { ctx.ui.notify(`Review return failed: ${e.message}`, "error"); } } });
 pi.registerCommand("requirements-plan-transition", { description: "Internal queued isolated-review transition", handler: async (_args, ctx) => { try { await transitionIsolated(ctx); } catch (e: any) { if (runtime.run) { runtime.run.last_error = { code: "BRANCH_TRANSITION_FAILED", message: e.message, retryable: true }; restorePolicy(pi, runtime.run); runtime.run.active = false; persistRun(pi, runtime.run); updateUi(ctx); ctx.ui.notify(`BRANCH_TRANSITION_FAILED: ${e.message}`, "error"); } } } });
 pi.registerTool({ name: "requirements_plan", label: "Requirements Plan", description: "Start, respond to, inspect, complete, cancel, or release a native requirements/planning stage. start must be the only tool call in its assistant message.", parameters: Type.Object({ action: StringEnum(ACTIONS), stage: Type.Optional(StringEnum(STAGES)), reference: Type.Optional(Type.String()), decision_id: Type.Optional(Type.String()), answer: Type.Optional(Type.String()), review_mode: Type.Optional(StringEnum(["current", "isolated"] as const)) }, { additionalProperties: false }), async execute(_id, params, _signal, _update, ctx) { if (assistantHasMixedStart(ctx)) return toolResult(errorResult(params.action as any, ctx.sessionManager.getSessionId(), "transition_requires_exclusive_call", "requirements_plan start must be the only tool call in the assistant message; the whole batch was rejected.", true, params.stage)); const checked = validateInput(params); const prior = runtime.run ? { ...runtime.run } : undefined; const result = checked.ok ? await service.dispatch(checked.value, ctx) : errorResult(params.action as any, ctx.sessionManager.getSessionId(), "INVALID_INPUT", checked.message, true, params.stage); const endAction = result.state === "ok" && result.outcome.kind === "decision_applied" && ["return-only", "return-summary", "return-resolve"].includes(result.outcome.summary ?? "") ? result.outcome.summary : undefined; if (endAction && prior) { prior.last_error = { code: "QUEUED_REVIEW_RETURN", message: endAction, retryable: false }; queuedReviewReturn = prior; pi.sendUserMessage("/requirements-plan-return", { deliverAs: "followUp", expandPromptTemplates: true }); } else await maybeStartAgent(ctx, result, true); return toolResult(result); } });
 pi.registerTool({ name: "requirements_plan_read", label: "Workflow Read", description: "Read only a path explicitly authorized for the active workflow stage.", parameters: Type.Object({ path: Type.String(), offset: Type.Optional(Type.Integer({ minimum: 1 })), limit: Type.Optional(Type.Integer({ minimum: 1, maximum: 2000 })) }, { additionalProperties: false }), async execute(_id, params, _signal, _update, ctx) { if (!runtime.run?.active) throw new Error("No workflow stage is active."); const p = authorizeRead(runtime.run, params.path, ctx.cwd); const text = await fs.readFile(p, "utf8"); const lines = text.split(/\r?\n/); const start = (params.offset ?? 1) - 1; const selected = lines.slice(start, start + (params.limit ?? 2000)).join("\n"); return { content: [{ type: "text", text: selected.slice(0, 50 * 1024) }], details: { path: p, content_hash: await hashFile(p), truncated: selected.length > 50 * 1024 || start + (params.limit ?? 2000) < lines.length } }; } });
 pi.registerTool({ name: "requirements_plan_stage", label: "Workflow Stage", description: "Private active-stage plumbing: request a human decision, propose an exact approved Org mutation, or submit a bounded review report.", parameters: Type.Object({ operation: StringEnum(["request_decision", "propose_mutation", "submit_report"] as const), kind: Type.Optional(Type.String()), prompt: Type.Optional(Type.String()), choices: Type.Optional(Type.Array(Type.Object({ id: Type.String(), label: Type.String(), description: Type.Optional(Type.String()) }))), target: Type.Optional(Type.String()), expected_hash: Type.Optional(Type.String()), content: Type.Optional(Type.String()), summary: Type.Optional(Type.String()), report: Type.Optional(Type.String()) }, { additionalProperties: false }), async execute(_id, p, _signal, _update, ctx) { const run = runtime.run; if (!run?.active) throw new Error("No workflow stage is active."); if (p.operation === "request_decision") { if (!p.kind || !p.prompt) throw new Error("kind and prompt are required."); const result = await service.pending("status", run.session_id, run, { kind: p.kind, prompt: p.prompt, choices: p.choices }, "stage-decision"); service.save(ctx); return toolResult(result); } if (p.operation === "propose_mutation") { if (!isWritableStage(run.stage)) throw Object.assign(new Error("Review stages cannot propose Org mutations."), { code: "CAPABILITY_BLOCKED" }); if (!p.target || p.content === undefined) throw new Error("target and content are required."); const target = path.resolve(p.target); const artifact = run.artifacts.find(a => a.path === target); if (!artifact && !(run.stage === "clarify-requirements" && path.dirname(target) === run.task.directory && ["requirements.org", "plan.org"].includes(path.basename(target)))) throw new Error("Target is not an authorized active artifact."); const result = await service.pending("status", run.session_id, run, { kind: "org-mutation", prompt: p.summary || `Apply the proposed update to ${target}?`, choices: [{ id: "approve", label: "Apply update" }, { id: "reject", label: "Reject" }] }, "mutation", { target, expected_hash: p.expected_hash ?? artifact?.content_hash, content: p.content }); service.save(ctx); return toolResult(result); } if (!p.report) throw new Error("report is required."); if (isWritableStage(run.stage)) throw new Error("Only review stages submit review reports."); const handoff = handoffFromReport(run.stage, run.artifacts, p.report); await saveHandoff(handoff); run.handoff_id = handoff.id; persistRun(pi, run); pi.appendEntry("requirements-plan-review-report", { run_id: run.run_id, stage: run.stage, handoff_id: handoff.id, report: p.report, at: new Date().toISOString() }); if (run.review_mode === "current") { restorePolicy(pi, run); run.active = false; persistRun(pi, undefined); runtime.run = undefined; updateUi(ctx); } return { content: [{ type: "text", text: run.review_mode === "current" ? "Review report accepted; current-conversation review ended automatically." : "Review report accepted; isolated review remains active until explicitly ended." }], details: { accepted: true, review_mode: run.review_mode } }; } });
 pi.on("tool_call", (event, ctx) => { if (assistantHasMixedStart(ctx)) return { block: true, reason: "transition_requires_exclusive_call: requirements_plan start must be the only call in this batch." }; if (!toolAllowed(runtime.run, event.toolName)) return { block: true, reason: `CAPABILITY_BLOCKED: ${event.toolName} is not allowed during ${runtime.run?.stage}.` }; });
 pi.on("user_bash", (_event, _ctx) => { if (runtime.run?.active) return { result: { output: `CAPABILITY_BLOCKED: direct shell is disabled during ${runtime.run.stage}.`, exitCode: 126, cancelled: false, truncated: false } }; });
 pi.on("before_agent_start", (event) => { const run = runtime.run; if (!run?.active) return; return { systemPrompt: `${event.systemPrompt}\n\n[REQUIREMENTS/PLANNING WORKFLOW ACTIVE]\n${STAGE_PROMPTS[run.stage]}\nTask: ${run.task.directory}\nArtifacts: ${run.artifacts.map(a => `${a.path} ${a.content_hash ?? "missing"}`).join("; ")}\nApplicable instructions: ${run.instructions.join(", ") || "none"}\nOnly use requirements_plan_read, requirements_plan_stage, and requirements_plan. Never implement.`, message: { customType: "requirements-plan-context", content: `Workflow ${run.run_id} is active in ${run.stage}. Runtime policy is authoritative.`, display: false } }; });
 pi.on("session_start", (_event, ctx) => { runtime.run = restoreRun(ctx); if (runtime.run?.active) applyPolicy(pi, runtime.run); updateUi(ctx); });
 pi.on("session_tree", (_event, ctx) => { const old = runtime.run; runtime.run = restoreRun(ctx); if (old?.active && !runtime.run?.active) restorePolicy(pi, old); if (runtime.run?.active) applyPolicy(pi, runtime.run); updateUi(ctx); });
 pi.on("session_shutdown", (_event, _ctx) => { if (runtime.run?.active) restorePolicy(pi, runtime.run); });
 pi.registerEntryRenderer("requirements-plan-review-report", (entry, { expanded }, theme) => { const d = entry.data as any; return new Text(theme.fg("accent", `Workflow review report (${d.stage})`) + (expanded ? `\n${d.report}` : ""), 0, 0); });
}
